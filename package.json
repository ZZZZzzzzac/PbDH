{
  "name": "pbdh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/platform",
    "apps/player",
    "apps/creator",
    "apps/market",
    "packages/contract-runtime",
    "packages/templates",
    "packages/resource-renderer",
    "packages/resource-conversion",
    "packages/tabletop",
    "packages/local-storage",
    "packages/media-admission",
    "packages/platform-auth",
    "packages/platform-ui",
    "packages/publication-ui"
  ],
  "scripts": {
    "check:boundaries": "node --test scripts/dependency-boundaries.test.mjs && node scripts/check-dependency-boundaries.mjs",
    "sync:platform-app-bar": "node scripts/sync-platform-app-bar-design.mjs",
    "generate:design": "node scripts/generate-adversary-card-design.mjs && node scripts/generate-weapon-card-design.mjs && node scripts/generate-player-design.mjs && node scripts/generate-market-design.mjs",
    "check:design": "node scripts/generate-adversary-card-design.mjs --check && node scripts/generate-weapon-card-design.mjs --check && node scripts/generate-player-design.mjs --check && node scripts/generate-market-design.mjs --check",
    "test:ts": "vitest run tests",
    "test:python": "node scripts/python.mjs -m pytest tests",
    "typecheck": "tsc --noEmit",
    "dev:platform": "npm run dev -w @pbdh/platform",
    "build:platform": "npm run build -w @pbdh/platform",
    "dev:backend": "node --env-file-if-exists=.env.local scripts/python.mjs -m uvicorn pbdh_backend.app:create_app --factory --app-dir apps/backend/src --reload --port 8001",
    "verify": "npm run check:boundaries && npm run check:design && npm run test:ts && npm run test:python && npm run typecheck && npm run build:platform"
  },
  "dependencies": {
    "dexie": "4.4.4",
    "fflate": "0.8.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "ajv": "8.17.1",
    "fake-indexeddb": "6.2.5",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  }
}
