{
  "name": "pbdh",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/platform",
    "apps/player",
    "apps/creator",
    "apps/market",
    "packages/contract-runtime",
    "packages/templates",
    "packages/resource-renderer",
    "packages/resource-conversion",
    "packages/tabletop",
    "packages/local-storage",
    "packages/cloud-documents",
    "packages/media-admission",
    "packages/platform-auth",
    "packages/platform-ui",
    "packages/publication-ui"
  ],
  "scripts": {
    "check:boundaries": "node --test scripts/dependency-boundaries.test.mjs && node scripts/check-dependency-boundaries.mjs",
    "check:contract-releases": "node scripts/check-contract-releases.mjs && node scripts/python.mjs scripts/generate_backend_openapi.py --check",
    "check:visual-sources": "node scripts/check-visual-sources.mjs",
    "test:ts": "vitest run tests",
    "test:python": "node scripts/python.mjs -m pytest tests",
    "measure:renderer": "tsx scripts/measure-renderer-performance.ts",
    "template:status": "tsx scripts/template-status.ts",
    "system-package": "tsx scripts/system-package-cli.ts",
    "build:daggerheart-core": "tsx scripts/build-daggerheart-core-system-package.ts",
    "check:daggerheart-core": "tsx scripts/build-daggerheart-core-system-package.ts --check",
    "sync:builtin-system-packages": "tsx scripts/sync-bundled-system-package-metadata.ts",
    "check:builtin-system-packages": "tsx scripts/sync-bundled-system-package-metadata.ts --check",
    "pbres:unpack": "tsx scripts/pbres-workspace-cli.ts unpack",
    "pbres:pack": "tsx scripts/pbres-workspace-cli.ts pack",
    "typecheck": "tsc --noEmit",
    "dev:platform": "npm run dev -w @pbdh/platform",
    "build:platform": "npm run build -w @pbdh/platform",
    "dev:backend": "node --env-file-if-exists=.env.local scripts/python.mjs -m uvicorn pbdh_backend.app:create_app --factory --app-dir apps/backend/src --reload --port 8001",
    "verify": "npm run check:boundaries && npm run check:contract-releases && npm run check:visual-sources && npm run check:builtin-system-packages && npm run test:ts && npm run test:python && npm run typecheck && npm run measure:renderer && npm run build:platform"
  },
  "dependencies": {
    "dexie": "4.4.4",
    "fflate": "0.8.3",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/node": "26.1.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "ajv": "8.17.1",
    "fake-indexeddb": "6.2.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "vite": "8.1.3",
    "vitest": "4.1.10"
  }
}
