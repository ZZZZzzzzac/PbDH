{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbdh.dev/templates/%E8%87%AA%E7%94%B1/1.0.0/schema.json",
  "title": "自由 Template Data",
  "type": "object",
  "required": ["名称", "内容"],
  "properties": {
    "名称": { "type": "string" },
    "内容": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["标题", "正文"],
        "properties": {
          "标题": { "type": "string" },
          "正文": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
