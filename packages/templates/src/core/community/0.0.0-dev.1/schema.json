{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbdh.dev/templates/%E7%A4%BE%E7%BE%A4/0.0.0-dev.1/schema.json",
  "title": "社群临时 Template Data",
  "type": "object",
  "required": ["名称", "简介", "性格", "特性"],
  "properties": {
    "名称": { "type": "string" },
    "简介": { "type": "string" },
    "性格": { "type": "string" },
    "特性": {
      "type": "object",
      "required": ["名称", "描述"],
      "properties": {
        "名称": { "type": "string" },
        "描述": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
