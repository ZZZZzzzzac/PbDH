{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbdh.dev/templates/%E8%81%8C%E4%B8%9A/1.0.0/schema.json",
  "title": "职业 Template Data",
  "type": "object",
  "required": ["名称", "类型", "描述", "领域", "生命点", "闪避值", "职业物品", "希望特性", "职业特性", "推荐初始属性", "推荐初始武器", "推荐初始护甲", "背景问题", "关系问题", "施法属性"],
  "properties": {
    "名称": { "type": "string" },
    "原文": { "type": "string" },
    "类型": { "type": "string" },
    "描述": { "type": "string" },
    "领域": { "type": "array", "items": { "type": "string" } },
    "生命点": { "type": "string" },
    "闪避值": { "type": "string" },
    "职业物品": { "type": "string" },
    "希望特性": { "type": "string" },
    "职业特性": { "type": "string" },
    "推荐初始属性": {
      "type": "array",
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "propertyNames": { "minLength": 1 },
        "additionalProperties": { "type": "string" }
      }
    },
    "推荐初始武器": { "type": "array", "items": { "type": "string" } },
    "推荐初始护甲": { "type": "string" },
    "背景问题": { "type": "array", "items": { "type": "string" } },
    "关系问题": { "type": "array", "items": { "type": "string" } },
    "施法属性": { "type": "string" }
  },
  "additionalProperties": false
}
