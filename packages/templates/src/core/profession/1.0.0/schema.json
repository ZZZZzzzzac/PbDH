{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbdh.dev/templates/%E8%81%8C%E4%B8%9A/1.0.0/schema.json",
  "title": "职业 Template Data",
  "type": "object",
  "required": ["名称", "类型", "风味描述", "领域", "生命点", "闪避值", "职业物品", "希望特性", "特性", "推荐初始属性", "推荐初始武器", "推荐初始护甲", "背景问题", "关系问题"],
  "properties": {
    "名称": { "type": "string" },
    "原文": { "type": "string" },
    "类型": { "type": "string" },
    "风味描述": { "type": "string" },
    "领域": { "type": "array", "maxItems": 2, "items": { "type": "string" } },
    "生命点": { "type": "string" },
    "闪避值": { "type": "string" },
    "职业物品": { "type": "string" },
    "希望特性": {
      "type": "object",
      "required": ["名称", "特性描述"],
      "properties": {
        "名称": { "type": "string" },
        "原名": { "type": "string" },
        "特性描述": { "type": "string" }
      },
      "additionalProperties": false
    },
    "特性": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["名称", "特性描述"],
        "properties": {
          "名称": { "type": "string" },
          "原名": { "type": "string" },
          "特性描述": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "推荐初始属性": {
      "type": "object",
      "required": ["敏捷", "力量", "灵巧", "本能", "风度", "知识"],
      "properties": {
        "敏捷": { "type": "string" }, "力量": { "type": "string" }, "灵巧": { "type": "string" },
        "本能": { "type": "string" }, "风度": { "type": "string" }, "知识": { "type": "string" }
      },
      "additionalProperties": false
    },
    "推荐初始武器": { "type": "string" },
    "推荐初始护甲": { "type": "string" },
    "背景问题": { "type": "array", "items": { "type": "string" } },
    "关系问题": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
