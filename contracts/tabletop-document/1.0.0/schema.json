{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbdh.dev/contracts/tabletop-document/1.0.0/schema.json",
  "title": "Tabletop Document logical document",
  "type": "object",
  "required": ["contractVersion", "documentId", "name", "createdAt", "updatedAt", "instances", "assets"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "documentId": { "$ref": "#/$defs/uuid" },
    "name": { "type": "string", "minLength": 1 },
    "createdAt": { "$ref": "#/$defs/timestamp" },
    "updatedAt": { "$ref": "#/$defs/timestamp" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "instances": { "type": "array", "items": { "$ref": "#/$defs/instance" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" } }
  },
  "additionalProperties": false,
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$" },
    "assetId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "minimum": 640 },
        "height": { "type": "number", "minimum": 480 }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["id", "mediaType", "byteLength", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/assetId" },
        "mediaType": { "const": "image/webp" },
        "byteLength": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "width": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "height": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      },
      "additionalProperties": false
    },
    "templateReference": {
      "type": "object",
      "required": ["id", "version"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "$ref": "#/$defs/semver" } },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "required": ["width", "height", "unit", "mode", "fixedRatio"],
      "properties": {
        "width": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "height": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "unit": { "const": "mm" },
        "mode": { "enum": ["text", "split", "image"] },
        "fixedRatio": { "type": "boolean" }
      },
      "allOf": [
        { "properties": { "width": { "const": "63" } } },
        {
          "if": { "properties": { "fixedRatio": { "const": true } }, "required": ["fixedRatio"] },
          "then": { "properties": { "height": { "const": "88" } } }
        }
      ],
      "additionalProperties": false
    },
    "stringJsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/stringJsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/stringJsonValue" } }
      ]
    },
    "replacement": {
      "type": "object",
      "required": ["replacementId", "targetResourceId"],
      "properties": {
        "replacementId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "targetResourceId": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "resourceCopy": {
      "type": "object",
      "required": ["source", "template", "presentation", "data", "labels", "replacements", "media"],
      "properties": {
        "source": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["packageId", "resourceId"],
              "properties": {
                "packageId": { "$ref": "#/$defs/uuid" },
                "resourceId": { "type": "string", "minLength": 1, "maxLength": 128 }
              },
              "additionalProperties": false
            }
          ]
        },
        "template": { "$ref": "#/$defs/templateReference" },
        "presentation": { "$ref": "#/$defs/presentation" },
        "data": { "$ref": "#/$defs/stringJsonValue" },
        "labels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "replacements": { "type": "array", "items": { "$ref": "#/$defs/replacement" } },
        "media": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": { "$ref": "#/$defs/assetId" }
        }
      },
      "additionalProperties": false
    },
    "geometry": {
      "type": "object",
      "required": ["x", "y", "layer", "rotation", "flipped", "scale"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "layer": { "type": "integer", "minimum": 0 },
        "rotation": { "type": "number" },
        "flipped": { "type": "boolean" },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "instance": {
      "type": "object",
      "required": ["instanceId", "resourceCopy", "state", "geometry"],
      "properties": {
        "instanceId": { "$ref": "#/$defs/uuid" },
        "resourceCopy": { "$ref": "#/$defs/resourceCopy" },
        "state": { "type": "object", "propertyNames": { "minLength": 1 }, "additionalProperties": { "type": "string" } },
        "geometry": { "$ref": "#/$defs/geometry" }
      },
      "additionalProperties": false
    }
  }
}
