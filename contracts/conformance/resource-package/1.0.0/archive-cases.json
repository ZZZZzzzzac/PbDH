[
  {
    "name": "rejects-path-traversal",
    "mutation": { "kind": "add-file", "path": "../evil.json" },
    "candidate": false,
    "expected": [{
      "code": "resource-package.archive.path.invalid",
      "severity": "error",
      "family": "resource-package",
      "version": "1.0.0",
      "location": "/entries/3/path",
      "params": { "path": "../evil.json", "reason": "traversal" }
    }]
  },
  {
    "name": "rejects-absolute-path",
    "mutation": { "kind": "add-file", "path": "C:/evil.json" },
    "candidate": false,
    "expected": [{
      "code": "resource-package.archive.path.invalid",
      "severity": "error",
      "family": "resource-package",
      "version": "1.0.0",
      "location": "/entries/3/path",
      "params": { "path": "C:/evil.json", "reason": "absolute" }
    }]
  },
