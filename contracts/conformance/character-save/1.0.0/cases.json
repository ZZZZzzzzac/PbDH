[
  {
    "name": "accepts complete Module states",
    "mutation": null,
    "expected": []
  },
  {
    "name": "requires the bound system package",
    "mutation": {
      "op": "delete",
      "path": ["systemPackage"]
    },
    "expected": [
      {
        "code": "contract.schema.required",
        "severity": "error",
        "family": "character-save",
        "version": "1.0.0",
        "location": "/systemPackage",
        "params": { "property": "systemPackage" }
      }
    ]
  },
  {
    "name": "requires an independent Character Data version",
    "mutation": {
      "op": "delete",
      "path": ["characterDataVersion"]
    },
    "expected": [
      {
        "code": "contract.schema.required",
        "severity": "error",
        "family": "character-save",
        "version": "1.0.0",
        "location": "/characterDataVersion",
        "params": { "property": "characterDataVersion" }
      }
    ]
  },
  {
    "name": "rejects installed packages in the document",
    "mutation": {
      "op": "set",
      "path": ["installedResourcePackages"],
      "value": []
    },
    "expected": [
      {
        "code": "contract.schema.additional-property",
        "severity": "error",
        "family": "character-save",
        "version": "1.0.0",
        "location": "/installedResourcePackages",
        "params": { "property": "installedResourcePackages" }
      }
    ]
  },
  {
    "name": "accepts an empty Character Data dictionary",
    "mutation": {
      "op": "set",
      "path": ["characterData"],
      "value": {}
    },
    "expected": []
  },
  {
    "name": "requires a non-empty display name",
    "mutation": {
      "op": "set",
      "path": ["name"],
      "value": ""
    },
    "expected": [
      {
        "code": "contract.schema.min-length",
        "severity": "error",
        "family": "character-save",
        "version": "1.0.0",
        "location": "/name",
        "params": { "limit": 1 }
      }
    ]
  },
  {
    "name": "rejects a malformed UTC timestamp",
    "mutation": {
      "op": "set",
      "path": ["updatedAt"],
      "value": "2026-08-26 08:05:00"
    },
    "expected": [
      {
        "code": "contract.schema.invalid",
        "severity": "error",
        "family": "character-save",
        "version": "1.0.0",
        "location": "/updatedAt",
        "params": { "keyword": "pattern" }
      }
    ]
  },
  {
    "name": "system package reference rejects undeclared fields",
    "mutation": {
      "op": "set",
      "path": ["systemPackage", "name"],
      "value": "Duplicated identity"
    },
    "expected": [
      {
        "code": "contract.schema.additional-property",
        "severity": "error",
        "family": "character-save",
        "version": "1.0.0",
        "location": "/systemPackage/name",
        "params": { "property": "name" }
      }
    ]
  }
]
