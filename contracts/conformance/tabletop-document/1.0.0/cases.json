[
  {
    "name": "valid tabletop document with one replacement pointer",
    "mutation": null,
    "expected": []
  },
  {
    "name": "rejects missing replacement list",
    "mutation": { "op": "delete", "path": ["instances", 0, "resourceCopy", "replacements"] },
    "expected": [
      {
        "code": "contract.schema.required",
        "severity": "error",
        "family": "tabletop-document",
        "version": "1.0.0",
        "location": "/instances/0/resourceCopy/replacements",
        "params": { "property": "replacements" }
      }
    ]
  },
  {
    "name": "rejects non-positive instance width",
    "mutation": { "op": "set", "path": ["instances", 0, "geometry", "width"], "value": 0 },
    "expected": [
      {
        "code": "contract.schema.invalid",
        "severity": "error",
        "family": "tabletop-document",
        "version": "1.0.0",
        "location": "/instances/0/geometry/width",
        "params": { "keyword": "exclusiveMinimum" }
      }
    ]
  },
  {
    "name": "rejects presentation-owned card dimensions",
    "mutation": { "op": "set", "path": ["instances", 0, "resourceCopy", "presentation", "width"], "value": "63" },
    "expected": [
      {
        "code": "contract.schema.additional-property",
        "severity": "error",
        "family": "tabletop-document",
        "version": "1.0.0",
        "location": "/instances/0/resourceCopy/presentation/width",
        "params": { "property": "width" }
      }
    ]
  },
  {
    "name": "accepts template-defined non-string state values",
    "mutation": { "op": "set", "path": ["instances", 0, "state"], "value": { "counter": 2, "active": true, "details": { "note": "ready" } } },
    "expected": []
  },
  {
    "name": "rejects hidden replacement forms",
    "mutation": { "op": "set", "path": ["instances", 0, "materializedForms"], "value": [] },
    "expected": [
      {
        "code": "contract.schema.additional-property",
        "severity": "error",
        "family": "tabletop-document",
        "version": "1.0.0",
        "location": "/instances/0/materializedForms",
        "params": { "property": "materializedForms" }
      }
    ]
  }
]
