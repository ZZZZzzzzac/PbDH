{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbdh.dev/contracts/system-package/1.0.0/schema.json",
  "title": "System Package",
  "type": "object",
  "required": ["contractVersion", "package", "runtime"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "package": {
      "type": "object",
      "required": ["id", "version", "name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/uuidV7" },
        "version": { "$ref": "#/$defs/semver" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["characterDataVersion", "pages", "modules"],
      "properties": {
        "characterDataVersion": { "$ref": "#/$defs/semver" },
        "characterDataMigrations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["fromVersion", "toVersion", "script"],
            "properties": {
              "fromVersion": { "$ref": "#/$defs/semver" },
              "toVersion": { "$ref": "#/$defs/semver" },
              "script": { "$ref": "#/$defs/packagePath" }
            },
            "additionalProperties": false
          }
        },
        "loadingPresentation": {
          "type": "object",
          "required": ["tagline", "accentColor"],
          "properties": {
            "tagline": { "type": "string", "minLength": 1, "maxLength": 80 },
            "accentColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
          },
          "additionalProperties": false
        },
        "pages": { "$ref": "#/$defs/packagePath" },
        "shell": {
          "type": "object",
          "required": ["html"],
          "properties": {
            "html": { "$ref": "#/$defs/packagePath" },
            "css": { "$ref": "#/$defs/packagePath" }
          },
          "additionalProperties": false
        },
        "skins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "css", "frameworkColorScheme"],
            "properties": {
              "id": { "$ref": "#/$defs/runtimeId" },
              "name": { "type": "string", "minLength": 1 },
              "css": { "$ref": "#/$defs/packagePath" },
              "frameworkColorScheme": { "enum": ["light", "dark"] },
              "layoutOverrides": {
                "type": "object",
                "properties": {
                  "shell": {
                    "type": "object",
                    "required": ["html"],
                    "properties": { "html": { "$ref": "#/$defs/packagePath" } },
                    "additionalProperties": false
                  },
                  "pages": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "required": ["id", "html"],
                      "properties": {
                        "id": { "$ref": "#/$defs/runtimeId" },
                        "html": { "$ref": "#/$defs/packagePath" }
                      },
                      "additionalProperties": false
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "defaultSkin": { "$ref": "#/$defs/runtimeId" },
        "modules": { "$ref": "#/$defs/packagePath" },
        "dependencies": { "$ref": "#/$defs/packagePath" },
        "characterCreationGuide": { "$ref": "#/$defs/packagePath" },
        "questionnaireCharacterCreation": {
          "type": "object",
          "required": ["id", "name", "html"],
          "properties": {
            "id": { "$ref": "#/$defs/runtimeId" },
            "name": { "type": "string", "minLength": 1 },
            "html": { "$ref": "#/$defs/packagePath" }
          },
          "additionalProperties": false
        },
        "characterFormatAdapters": { "$ref": "#/$defs/packagePath" },
        "characterTextExports": { "$ref": "#/$defs/packagePath" },
        "validationChecks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "script"],
            "properties": {
              "id": { "$ref": "#/$defs/runtimeId" },
              "script": { "$ref": "#/$defs/packagePath" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "resourceCompatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["templateId", "versionRange", "nativeEntry"],
        "properties": {
          "templateId": { "type": "string", "minLength": 1 },
          "versionRange": {
            "type": "object",
            "required": ["minimumInclusive", "maximumExclusive"],
            "properties": {
              "minimumInclusive": { "$ref": "#/$defs/semver" },
              "maximumExclusive": { "$ref": "#/$defs/semver" }
            },
            "additionalProperties": false
          },
          "nativeEntry": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/runtimeId" },
              "label": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "embeddedResources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path"],
        "properties": {
          "path": { "type": "string", "pattern": "^resources/[a-z0-9][a-z0-9-]*\\.pbres$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "runtimeId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$)).+$"
    }
  }
}
