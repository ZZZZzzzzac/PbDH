{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbdh.dev/contracts/system-package/1.0.0-alpha.1/schema.json",
  "title": "System Package",
  "type": "object",
  "required": [
    "contractVersion",
    "package",
    "resourceCompatibility",
    "modules",
    "dependencies",
    "embeddedResources"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0-alpha.1" },
    "package": {
      "type": "object",
      "required": ["id", "version", "name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/uuidV7" },
        "version": { "$ref": "#/$defs/semver" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "resourceCompatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["templateId", "versionRange", "nativeEntry"],
        "properties": {
          "templateId": { "type": "string", "minLength": 1 },
          "versionRange": {
            "type": "object",
            "required": ["minimumInclusive", "maximumExclusive"],
            "properties": {
              "minimumInclusive": { "$ref": "#/$defs/semver" },
              "maximumExclusive": { "$ref": "#/$defs/semver" }
            },
            "additionalProperties": false
          },
          "nativeEntry": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "label": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["id", "type", "nativeEntryId", "buttonLabel", "columns"],
            "properties": {
              "id": { "$ref": "#/$defs/moduleId" },
              "type": { "const": "resourcePicker" },
              "nativeEntryId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "buttonLabel": { "type": "string", "minLength": 1 },
              "columns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["field", "label", "width", "sortable", "filterable"],
                  "properties": {
                    "field": { "type": "string", "minLength": 1 },
                    "label": { "type": "string", "minLength": 1 },
                    "width": { "enum": ["compact", "normal", "wide", "fill"] },
                    "sortable": { "type": "boolean" },
                    "filterable": { "type": "boolean" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": ["id", "type", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/moduleId" },
              "type": { "enum": ["freeText", "longText"] },
              "label": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "trigger", "condition", "actions"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "trigger": {
            "type": "object",
            "required": ["type", "sourceModuleId"],
            "properties": {
              "type": { "const": "resourceSelected" },
              "sourceModuleId": { "$ref": "#/$defs/moduleId" }
            },
            "additionalProperties": false
          },
          "condition": {
            "type": "object",
            "required": ["type"],
            "properties": { "type": { "const": "always" } },
            "additionalProperties": false
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["type", "targetModuleId", "content"],
              "properties": {
                "type": { "const": "fillText" },
                "targetModuleId": { "$ref": "#/$defs/moduleId" },
                "content": {
                  "oneOf": [
                    {
                      "type": "object",
                      "required": ["type", "field"],
                      "properties": {
                        "type": { "const": "selectedResourceField" },
                        "field": { "type": "string", "minLength": 1 }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": ["type", "format"],
                      "properties": {
                        "type": { "const": "selectedResourceTemplate" },
                        "format": { "type": "string", "minLength": 1 }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "embeddedResources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "packageId", "version", "minimumVersion", "snapshotDigest"],
        "properties": {
          "path": { "type": "string", "pattern": "^resources/[a-z0-9][a-z0-9-]*\\.pbres$" },
          "packageId": { "$ref": "#/$defs/uuidV7" },
          "version": { "$ref": "#/$defs/semver" },
          "minimumVersion": { "$ref": "#/$defs/semver" },
          "snapshotDigest": { "$ref": "#/$defs/digest" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
