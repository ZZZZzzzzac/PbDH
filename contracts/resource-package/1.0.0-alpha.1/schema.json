{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pbdh.dev/contracts/resource-package/1.0.0-alpha.1/schema.json",
  "title": "Resource Package logical document",
  "type": "object",
  "required": [
    "contractVersion",
    "package",
    "targets",
    "license",
    "forkSource",
    "assets",
    "resources",
    "emptyDirectories",
    "snapshotDigest"
  ],
  "properties": {
    "contractVersion": {
      "const": "1.0.0-alpha.1"
    },
    "package": {
      "$ref": "#/$defs/packageIdentity"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "license": {
      "$ref": "#/$defs/license"
    },
    "publication": {
      "$ref": "#/$defs/publicationMetadata"
    },
    "forkSource": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/forkSource" }
      ]
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "emptyDirectories": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "snapshotDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "uuidV7": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assetId": {
      "$ref": "#/$defs/digest"
    },
    "packageIdentity": {
      "type": "object",
      "required": ["id", "version", "name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/uuidV7" },
        "version": { "$ref": "#/$defs/semver" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "required": ["systemPackageId", "version"],
      "properties": {
        "systemPackageId": { "$ref": "#/$defs/uuidV7" },
        "version": { "$ref": "#/$defs/semver" }
      },
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "required": ["label", "declaration"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "declaration": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "publicationMetadata": {
      "type": "object",
      "required": ["language", "tags", "coverAssetId"],
      "properties": {
        "language": { "type": "string", "minLength": 2, "maxLength": 35 },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 50 }
        },
        "coverAssetId": { "$ref": "#/$defs/assetId" }
      },
      "additionalProperties": false
    },
    "gameResourceReference": {
      "type": "object",
      "required": ["packageId", "resourceId"],
      "properties": {
        "packageId": { "$ref": "#/$defs/uuidV7" },
        "resourceId": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "additionalProperties": false
    },
    "forkSource": {
      "type": "object",
      "required": ["publicationId", "packageId", "version", "snapshotDigest", "copiedResources"],
      "properties": {
        "publicationId": { "$ref": "#/$defs/uuidV7" },
        "packageId": { "$ref": "#/$defs/uuidV7" },
        "version": { "$ref": "#/$defs/semver" },
        "snapshotDigest": { "$ref": "#/$defs/digest" },
        "copiedResources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gameResourceReference" }
        }
      },
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "required": ["id", "mediaType", "byteLength", "width", "height"],
      "properties": {
        "id": { "$ref": "#/$defs/assetId" },
        "mediaType": { "const": "image/webp" },
        "byteLength": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "width": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "height": { "type": "string", "pattern": "^[1-9][0-9]*$" }
      },
      "additionalProperties": false
    },
    "templateReference": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "$ref": "#/$defs/semver" }
      },
      "additionalProperties": false
    },
    "presentation": {
      "type": "object",
      "required": ["width", "height", "unit", "mode", "fixedRatio"],
      "properties": {
        "width": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "height": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "unit": { "const": "mm" },
        "mode": { "enum": ["text", "split", "image"] },
        "fixedRatio": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "stringJsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/stringJsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/stringJsonValue" }
        }
      ]
    },
    "resource": {
      "type": "object",
      "required": ["id", "path", "template", "presentation", "data", "media"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "path": { "type": "string", "minLength": 1 },
        "template": { "$ref": "#/$defs/templateReference" },
        "presentation": { "$ref": "#/$defs/presentation" },
        "data": { "$ref": "#/$defs/stringJsonValue" },
        "media": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z][a-z0-9-]*$" },
          "additionalProperties": { "$ref": "#/$defs/assetId" }
        }
      },
      "additionalProperties": false
    }
  }
}
