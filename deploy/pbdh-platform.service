[Unit]
Description=PbDH Platform Backend
After=network.target

[Service]
Type=simple
User=pbdh-platform
Group=pbdh-platform
WorkingDirectory=/var/www/pbdh-platform/current
EnvironmentFile=/etc/pbdh-platform.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/var/www/pbdh-platform/current/python-packages:/var/www/pbdh-platform/current/apps/backend/src
ExecStart=/usr/bin/python3.11 -m uvicorn pbdh_backend.app:create_app --factory --host 127.0.0.1 --port 8001 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pbdh-platform

[Install]
WantedBy=multi-user.target
