# 前端由宿主 Nginx 提供；Backend 由 pbdh-platform.service 管理。
PBDH_DATABASE_PATH=/var/lib/pbdh-platform/pbdh.sqlite3
PBDH_MIGRATIONS_PATH=/var/www/pbdh-platform/current/apps/backend/migrations
PBDH_PUBLICATION_MODE=production

# 设为空时账号功能保持关闭，离线 Player/Creator/GM 功能仍可使用。
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_AUDIENCE=authenticated
PBDH_ADMIN_AUTH_SUBJECT=

# 单账号可上传媒体的总字节数；留空表示不额外限制。
PBDH_ACCOUNT_MEDIA_QUOTA_BYTES=
